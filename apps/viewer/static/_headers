# Workers static assets serve /viewer.html directly, bypassing the Worker, so it needs the same headers /l/:id sets.
# The CSP must match VIEWER_CSP in apps/api/src/links/viewer.ts (apps/api/test/viewer-headers.test.ts checks it).
/viewer.html
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cache-Control: no-store

/viewer/*
  X-Content-Type-Options: nosniff
