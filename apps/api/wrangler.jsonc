{
  "name": "waypoint-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waypoint",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../db/d1/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "00000000000000000000000000000000" }],
  "vars": {
    "CLERK_ISSUER": "https://clerk.example.com",
    "CLERK_AUTHORIZED_PARTIES": "",
    "AI_GATEWAY_ID": "waypoint",
    "APNS_KEY_ID": "XXXXXXXXXX",
    "APNS_TEAM_ID": "XXXXXXXXXX",
    "APNS_TOPIC": "app.waypoint.ios",
    "APPLE_BUNDLE_ID": "app.waypoint.ios",
    "APPLE_ENVIRONMENTS": "Production,Sandbox",
    "APPLE_APP_APPLE_ID": "0"
  },
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "waypoint_usage" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "waypoint" }],
  "triggers": { "crons": ["0 * * * *"] },
  "ratelimits": [
    { "name": "LINK_VIEWS", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "LINK_PASSCODES", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "queues": {
    "producers": [
      { "binding": "PUSH_QUEUE", "queue": "waypoint-push" },
      { "binding": "USAGE_QUEUE", "queue": "waypoint-usage" }
    ],
    "consumers": [
      { "queue": "waypoint-push", "max_batch_size": 50, "max_batch_timeout": 5, "max_retries": 5 },
      { "queue": "waypoint-usage", "max_batch_size": 100, "max_batch_timeout": 30, "max_retries": 10 }
    ]
  },
  "workflows": [
    { "name": "waypoint-write", "binding": "WRITE_WORKFLOW", "class_name": "WriteWorkflow" },
    { "name": "waypoint-retranscribe", "binding": "RETRANSCRIBE_WORKFLOW", "class_name": "RetranscribeWorkflow" },
    { "name": "waypoint-research", "binding": "RESEARCH_WORKFLOW", "class_name": "ResearchWorkflow" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "WALLET", "class_name": "Wallet" },
      { "name": "GROUP_ROOM", "class_name": "GroupRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1-wallet", "new_sqlite_classes": ["Wallet"] },
    { "tag": "v2-group-room", "new_sqlite_classes": ["GroupRoom"] }
  ]
}
