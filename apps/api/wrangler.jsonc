{
  "name": "waypoint-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waypoint",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../db/d1/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "00000000000000000000000000000000" }],
  "vars": {
    "CLERK_ISSUER": "https://clerk.example.com",
    "CLERK_AUTHORIZED_PARTIES": "",
    "AI_GATEWAY_ID": "waypoint",
    "APPLE_BUNDLE_ID": "app.waypoint.ios",
    "APPLE_ENVIRONMENTS": "Production,Sandbox"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "WALLET", "class_name": "Wallet" },
      { "name": "GROUP_ROOM", "class_name": "GroupRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1-wallet", "new_sqlite_classes": ["Wallet"] },
    { "tag": "v2-group-room", "new_sqlite_classes": ["GroupRoom"] }
  ]
}
