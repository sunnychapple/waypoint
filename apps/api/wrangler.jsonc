{
  "name": "waypoint-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waypoint",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../db/d1/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "00000000000000000000000000000000" }],
  "durable_objects": { "bindings": [{ "name": "GROUP_ROOM", "class_name": "GroupRoom" }] },
  "migrations": [{ "tag": "v2-group-room", "new_sqlite_classes": ["GroupRoom"] }]
}
