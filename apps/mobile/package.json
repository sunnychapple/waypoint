{
  "name": "@waypoint/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform ios --clean",
    "export:ios": "expo export --platform ios --output-dir dist",
