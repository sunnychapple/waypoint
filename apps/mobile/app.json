{
  "expo": {
    "name": "Waypoint",
    "slug": "waypoint",
    "scheme": "waypoint",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "app.waypoint.ios",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Waypoint records a class or a talk so it can write down what is said, on this iPhone.",
        "UIBackgroundModes": ["audio"],
        "NSCameraUsageDescription": "Waypoint uses the camera to snap pages of homework and books. Pages are read on this iPhone."
      },
      "usesAppleSignIn": true
    },
    "plugins": [
      "expo-router",
      ["expo-sqlite", { "enableFTS": true }],
      ["expo-build-properties", { "ios": { "deploymentTarget": "26.0" } }],
      "expo-apple-authentication",
      "@clerk/expo"
    ]
  }
}
